{
  "info": {
    "name": "Support Tickets API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{idToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": ""
    },
    {
      "key": "idToken",
      "value": ""
    },
    {
      "key": "ticketId",
      "value": ""
    },
    {
      "key": "reportId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Create ticket",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tickets",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tickets"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Printer broken\",\n  \"description\": \"Paper jam\",\n  \"priority\": \"HIGH\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201\",()=>pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"ticketId\", pm.response.json().ticketId);"
            ]
          }
        }
      ]
    },
    {
      "name": "Get ticket",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tickets/{{ticketId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tickets",
            "{{ticketId}}"
          ]
        }
      }
    },
    {
      "name": "List tickets (status=OPEN, limit=10)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tickets?status=OPEN&limit=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tickets?status=OPEN&limit=10"
          ]
        }
      }
    },
    {
      "name": "Update ticket",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tickets/{{ticketId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tickets",
            "{{ticketId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}"
        }
      }
    },
    {
      "name": "Request report",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/reports",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "reports"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"OPEN\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"202\",()=>pm.response.to.have.status(202));",
              "pm.collectionVariables.set(\"reportId\", pm.response.json().reportId);"
            ]
          }
        }
      ]
    },
    {
      "name": "Get report (poll until COMPLETED, open downloadUrl)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/reports/{{reportId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "reports",
            "{{reportId}}"
          ]
        }
      }
    },
    {
      "name": "Delete ticket",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tickets/{{ticketId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tickets",
            "{{ticketId}}"
          ]
        }
      }
    }
  ]
}